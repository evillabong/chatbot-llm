@namespace Mimo.Ui.Components
@typeparam TValue

@* Campo de texto estándar de MIMO: etiqueta + input de Flowbite.
   Soporta enlace bidireccional con @bind-Value. Las apps no usan TextInput/Label directamente. *@
<div class="@(WrapperClass ?? "mb-4")">
    @if (!string.IsNullOrEmpty(Label))
    {
        <div class="mb-2">
            <Label Value="@Label" />
        </div>
    }
    <TextInput TValue="TValue"
               Value="Value"
               ValueChanged="ValueChanged"
               ValueExpression="ValueExpression"
               Type="@Type"
               Placeholder="@Placeholder"
               Required="Required"
               Disabled="Disabled"
               HelperText="@HelperText" />
</div>

@code {
    /// <summary>Texto de la etiqueta. Si es vacío no se renderiza etiqueta.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Valor enlazado (usar @bind-Value).</summary>
    [Parameter] public TValue? Value { get; set; }

    /// <summary>Callback de cambio de valor (parte de @bind-Value).</summary>
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }

    /// <summary>Expresión del valor (parte de @bind-Value; habilita validación).</summary>
    [Parameter] public System.Linq.Expressions.Expression<Func<TValue>>? ValueExpression { get; set; }

    /// <summary>Tipo HTML del input (text, email, password, number…).</summary>
    [Parameter] public string Type { get; set; } = "text";

    /// <summary>Texto de marcador de posición.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Texto de ayuda bajo el campo.</summary>
    [Parameter] public string? HelperText { get; set; }

    /// <summary>Marca el campo como requerido.</summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>Deshabilita el campo.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Clases del contenedor. Por defecto separa verticalmente los campos (mb-4).</summary>
    [Parameter] public string? WrapperClass { get; set; }
}
