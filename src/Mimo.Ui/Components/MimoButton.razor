@namespace Mimo.Ui.Components

@* Botón estándar de MIMO. Envuelve el Button de Flowbite y centraliza el estilo por variante.
   Las apps usan <MimoButton>, nunca el Button de Flowbite ni clases Tailwind directas. *@
<Button Color="FlowbiteColor"
        Type="@Type"
        Disabled="Disabled"
        Loading="Loading"
        class="@CssClass"
        @onclick="OnClick">
    @ChildContent
</Button>

@code {
    /// <summary>Contenido del botón (texto/íconos).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Acción al hacer clic.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>Variante visual.</summary>
    [Parameter] public MimoButtonVariant Variant { get; set; } = MimoButtonVariant.Primary;

    /// <summary>Tipo HTML del botón (button, submit, reset).</summary>
    [Parameter] public string Type { get; set; } = "button";

    /// <summary>Deshabilita el botón.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Muestra el spinner de carga y bloquea la interacción.</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>Ocupa todo el ancho disponible.</summary>
    [Parameter] public bool FullWidth { get; set; }

    private Button.ButtonColor FlowbiteColor => Variant switch
    {
        MimoButtonVariant.Secondary => Button.ButtonColor.Light,
        MimoButtonVariant.Danger    => Button.ButtonColor.Red,
        _                           => Button.ButtonColor.Default
    };

    private string CssClass => FullWidth ? "w-full justify-center" : string.Empty;
}
