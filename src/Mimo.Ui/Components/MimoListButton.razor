@namespace Mimo.Ui.Components

@* Fila seleccionable para listas/bandejas. Resalta cuando Selected es true. *@
<button type="button" @onclick="OnClick" class="@CssClass">
    @ChildContent
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>Marca la fila como seleccionada.</summary>
    [Parameter] public bool Selected { get; set; }

    private string CssClass =>
        "w-full border-b border-gray-100 px-4 py-3 text-left transition-colors dark:border-gray-700 " +
        (Selected
            ? "bg-blue-50 dark:bg-gray-700"
            : "hover:bg-gray-50 dark:hover:bg-gray-700/50");
}
