@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Navigation

<MimoShell Subtitle="@TenantSlug">
    <Actions>
        <AuthorizeView>
            <Authorized>
                <span class="text-sm text-gray-600 dark:text-gray-300">@context.User.Identity?.Name</span>
                <MimoButton Variant="MimoButtonVariant.Secondary" OnClick="LogoutAsync">Salir</MimoButton>
            </Authorized>
        </AuthorizeView>
    </Actions>
    <ChildContent>
        @Body
    </ChildContent>
</MimoShell>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string? TenantSlug { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            TenantSlug = state.User.FindFirst("tenant_slug")?.Value;
        }
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("login");
    }
}
