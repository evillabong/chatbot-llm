@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Navigation

<MimoShell Subtitle="@TenantSlug">
    <Nav>
        <MimoNavLink Href="" Match="NavLinkMatch.All">Inicio</MimoNavLink>
        <MimoNavLink Href="funcionarios">Funcionarios</MimoNavLink>
        <MimoNavLink Href="roles">Roles</MimoNavLink>
        <MimoNavLink Href="consola">Consola</MimoNavLink>
        <MimoNavLink Href="chat-interno">Chat interno</MimoNavLink>
        <MimoNavLink Href="conocimiento">Conocimiento</MimoNavLink>
        <MimoNavLink Href="mejora-continua">Mejora continua</MimoNavLink>
        <MimoNavLink Href="configuracion">Configuración</MimoNavLink>
        <MimoNavLink Href="api-keys">API keys</MimoNavLink>
        <MimoNavLink Href="webhooks">Webhooks</MimoNavLink>
    </Nav>
    <Actions>
        <AuthorizeView>
            <Authorized>
                <MimoText Muted Small>@context.User.Identity?.Name</MimoText>
                <MimoButton Variant="MimoButtonVariant.Secondary" OnClick="LogoutAsync">Salir</MimoButton>
            </Authorized>
        </AuthorizeView>
    </Actions>
    <ChildContent>
        @Body
    </ChildContent>
</MimoShell>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string? TenantSlug { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            TenantSlug = state.User.FindFirst("tenant_slug")?.Value;
        }
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("login");
    }
}
