<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mimo.Ui\Mimo.Ui.csproj" />
    <ProjectReference Include="..\Mimo.ApiClient\Mimo.ApiClient.csproj" />
  </ItemGroup>

  <!-- Compila el CSS de Tailwind (escanea Mimo.Ui + esta app) antes de construir.
       El binario standalone vive en tools/ (no se commitea; ver scripts). -->
  <Target Name="BuildTailwindCss" BeforeTargets="Build">
    <PropertyGroup>
      <TailwindExe>$(MSBuildProjectDirectory)\tools\tailwindcss.exe</TailwindExe>
    </PropertyGroup>
    <Warning Condition="!Exists('$(TailwindExe)')" Text="Tailwind CLI no encontrado en tools/tailwindcss.exe; el CSS (app.min.css) no se generará." />
    <Exec Condition="Exists('$(TailwindExe)')" Command="&quot;$(TailwindExe)&quot; -i ./wwwroot/css/app.css -o ./wwwroot/css/app.min.css --minify" StandardOutputImportance="low" />
  </Target>

</Project>
