@page "/consola"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.Kiota.Abstractions
@inject ConsoleService Console
@inject ConsoleHubClient Hub
@inject RolesService RolesApi

<PageTitle>Consola · MIMO</PageTitle>

<MimoPageHeader Title="Consola de atención"
                Description="Bandeja de tickets y conversaciones omnicanal en vivo.">
    <Actions>
        <MimoBadge Variant="@(_live ? MimoBadgeVariant.Success : MimoBadgeVariant.Neutral)">
            @(_live ? "En vivo" : "Sin conexión")
        </MimoBadge>
        <MimoButton Variant="MimoButtonVariant.Secondary" OnClick="RefreshAsync">Actualizar</MimoButton>
    </Actions>
</MimoPageHeader>

@if (_pageError is not null)
{
    <MimoAlert Variant="MimoAlertVariant.Error" Text="@_pageError" OnDismiss="() => _pageError = null" />
}

<MimoSplitPane>
    <Sidebar>
        <MimoTabs Tabs="_tabs" SelectedKey="@_tab" OnSelect="k => _tab = k" />
        <MimoScroll>
            @if (_loading)
            {
                <MimoEmptyState><MimoSpinner /></MimoEmptyState>
            }
            else
            {
                var list = _tab == "mine" ? _mine : _team;
                @if (list.Count == 0)
                {
                    <MimoEmptyState Message="Sin tickets aquí." />
                }
                else
                {
                    @foreach (var t in list)
                    {
                        <MimoListButton Selected="@(_selected?.Id == t.Id)" OnClick="() => SelectAsync(t)">
                            <MimoRow Justify="MimoJustify.Between">
                                <MimoText>@(t.CustomerName ?? "Cliente")</MimoText>
                                <MimoBadge Variant="StatusVariant(t.Status)">@StatusLabel(t.Status)</MimoBadge>
                            </MimoRow>
                            <MimoRow Gap="1">
                                <MimoText Muted Small>@ChannelLabel(t.Channel)</MimoText>
                                <MimoText Muted Small>· @PriorityLabel(t.Priority)</MimoText>
                            </MimoRow>
                        </MimoListButton>
                    }
                }
            }
        </MimoScroll>
    </Sidebar>

    <ChildContent>
        @if (_selected is null)
        {
            <MimoEmptyState Message="Selecciona un ticket para ver la conversación." />
        }
        else
        {
            <MimoBar>
                <div>
                    <MimoText>@(_conversation?.CustomerName ?? _selected.CustomerName ?? "Cliente")</MimoText>
                    <MimoRow Gap="1">
                        <MimoText Muted Small>@ChannelLabel(_selected.Channel)</MimoText>
                        <MimoBadge Variant="StatusVariant(_selected.Status)">@StatusLabel(_selected.Status)</MimoBadge>
                    </MimoRow>
                </div>
                <MimoActions>
                    @if (_selected.Status == 1)
                    {
                        <MimoButton Variant="MimoButtonVariant.Primary" Loading="_acting" OnClick="ClaimAsync">Reclamar</MimoButton>
                    }
                    @if (CanResolve(_selected.Status))
                    {
                        <MimoButton Variant="MimoButtonVariant.Secondary" Loading="_acting" OnClick="ResolveAsync">Resolver</MimoButton>
                    }
                    @if (CanTransfer(_selected.Status))
                    {
                        <MimoButton Variant="MimoButtonVariant.Secondary" OnClick="OpenTransfer">Transferir</MimoButton>
                    }
                    @if (CanClose(_selected.Status))
                    {
                        <MimoButton Variant="MimoButtonVariant.Danger" Loading="_acting" OnClick="CloseAsync">Cerrar</MimoButton>
                    }
                </MimoActions>
            </MimoBar>

            <MimoScroll Muted Padded>
                @if (_convLoading)
                {
                    <MimoEmptyState><MimoSpinner /></MimoEmptyState>
                }
                else if (_lines.Count > 0)
                {
                    @foreach (var line in _lines)
                    {
                        <MimoChatBubble Variant="BubbleVariant(line.Role)"
                                        Content="@line.Content"
                                        Author="@AuthorLabel(line.Role)"
                                        Time="@line.Time" />
                    }
                }
                else
                {
                    <MimoEmptyState Message="Sin mensajes." />
                }
            </MimoScroll>

            <MimoBar Footer="true">
                <MimoTextField WrapperClass="flex-1" TValue="string" @bind-Value="_reply"
                               Placeholder="@(_live ? "Escribe una respuesta…" : "Conectando…")"
                               Disabled="@(!_live)" />
                <MimoButton Variant="MimoButtonVariant.Primary" Loading="_sending"
                            Disabled="@(!_live || string.IsNullOrWhiteSpace(_reply))" OnClick="SendReplyAsync">
                    Enviar
                </MimoButton>
            </MimoBar>
        }
    </ChildContent>
</MimoSplitPane>

<MimoModal @bind-Show="_showTransfer" Title="Transferir ticket" Size="MimoModalSize.Small">
    <ChildContent>
        @if (_transferError is not null)
        {
            <MimoAlert Variant="MimoAlertVariant.Error" Text="@_transferError" />
        }
        <MimoSelect Label="Transferir al rol" @bind-Value="_transferRoleId" Options="_roleOptions" Placeholder="Selecciona un rol" />
        <MimoTextField Label="Motivo" @bind-Value="_transferReason" Placeholder="Opcional" />
        <MimoText Small Muted>Se reasigna automáticamente a un funcionario disponible del rol destino.</MimoText>
    </ChildContent>
    <FooterContent>
        <MimoActions AlignRight="true">
            <MimoButton Variant="MimoButtonVariant.Secondary" OnClick="() => _showTransfer = false">Cancelar</MimoButton>
            <MimoButton Variant="MimoButtonVariant.Primary" Loading="_transferring"
                        Disabled="@string.IsNullOrEmpty(_transferRoleId)" OnClick="ConfirmTransferAsync">
                Transferir
            </MimoButton>
        </MimoActions>
    </FooterContent>
</MimoModal>

@code {
    private static readonly IReadOnlyList<MimoTab> _tabs =
    [
        new("mine", "Míos"),
        new("team", "Equipo")
    ];

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<TicketResponse> _mine = [];
    private List<TicketResponse> _team = [];
    private bool _loading = true;
    private string _tab = "mine";

    private TicketResponse? _selected;
    private ConversationResponse? _conversation;
    private readonly List<ChatLine> _lines = [];
    private bool _convLoading;
    private bool _acting;
    private bool _sending;
    private bool _live;
    private string _reply = "";
    private string? _pageError;

    private bool _showTransfer;
    private string _transferRoleId = "";
    private string _transferReason = "";
    private bool _transferring;
    private string? _transferError;
    private IReadOnlyList<MimoSelectOption> _roleOptions = [];

    protected override async Task OnInitializedAsync()
    {
        Hub.MessageReceived += OnHubMessage;
        Hub.QueueChanged += OnQueueChanged;
        await RefreshAsync();
        try
        {
            var roles = await RolesApi.ListAsync(isActive: true);
            _roleOptions = roles.Where(r => r.Id is not null)
                .Select(r => new MimoSelectOption(r.Id!.Value.ToString(), r.Name ?? "")).ToList();
        }
        catch { /* el desplegable de transferencia queda vacío si falla */ }
        try
        {
            await Hub.StartAsync();
            // Suscribirse a las colas de los roles del agente (claims role_id del token) para
            // recibir en vivo nuevos tickets, asignaciones y resoluciones.
            if (AuthState is not null)
            {
                var roleIds = (await AuthState).User.FindAll("role_id").Select(c => c.Value).ToList();
                await Hub.JoinRoleQueuesAsync(roleIds);
            }
        }
        catch { /* la consola funciona sin tiempo real; el badge lo refleja */ }
        _live = Hub.IsConnected;
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        _pageError = null;
        try
        {
            _mine = await Console.MyTicketsAsync();
            _team = await Console.VisibleTicketsAsync();
        }
        catch (Exception ex) { _pageError = Describe(ex); }
        finally { _loading = false; }
    }

    private async Task SelectAsync(TicketResponse t)
    {
        _selected = t;
        _conversation = null;
        _lines.Clear();
        if (t.ConversationId is null) return;

        _convLoading = true;
        try
        {
            _conversation = await Console.ConversationAsync(t.ConversationId.Value);
            if (_conversation?.Messages is { } msgs)
                _lines.AddRange(msgs.Select(m =>
                    new ChatLine(m.Role ?? 0, m.Content ?? "", Fmt(m.CreatedAt))));

            if (_live)
                await Hub.OpenConversationAsync(t.ConversationId.Value);
        }
        catch (Exception ex) { _pageError = Describe(ex); }
        finally { _convLoading = false; }
    }

    private void OnHubMessage(ConsoleHubClient.IncomingMessage m)
    {
        _lines.Add(new ChatLine(m.Role, m.Content, Fmt(m.CreatedAt)));
        InvokeAsync(StateHasChanged);
    }

    // La cola cambió (nuevo ticket / asignación / resolución): refrescar la bandeja sin spinner.
    private void OnQueueChanged() => _ = InvokeAsync(async () =>
    {
        try
        {
            _mine = await Console.MyTicketsAsync();
            _team = await Console.VisibleTicketsAsync();
            StateHasChanged();
        }
        catch { /* ignorar; el botón Actualizar permite recuperación manual */ }
    });

    private async Task SendReplyAsync()
    {
        if (_selected?.ConversationId is null || string.IsNullOrWhiteSpace(_reply)) return;
        _sending = true;
        try
        {
            await Hub.SendMessageAsync(_selected.ConversationId.Value, _reply.Trim());
            _reply = "";   // el mensaje vuelve por SignalR y se agrega al hilo
        }
        catch (Exception ex) { _pageError = $"No se pudo enviar: {ex.Message}"; }
        finally { _sending = false; }
    }

    private Task ClaimAsync()   => ActAsync(id => Console.ClaimAsync(id));
    private Task ResolveAsync() => ActAsync(id => Console.ResolveAsync(id));
    private Task CloseAsync()   => ActAsync(id => Console.CloseAsync(id));

    private async Task ActAsync(Func<Guid, Task<TicketResponse?>> action)
    {
        if (_selected?.Id is null) return;
        var id = _selected.Id.Value;
        _acting = true;
        _pageError = null;
        try
        {
            await action(id);
            await RefreshAsync();
            _selected = _mine.Concat(_team).FirstOrDefault(x => x.Id == id) ?? _selected;
        }
        catch (Exception ex) { _pageError = Describe(ex); }
        finally { _acting = false; }
    }

    private void OpenTransfer()
    {
        _transferRoleId = "";
        _transferReason = "";
        _transferError = null;
        _showTransfer = true;
    }

    private async Task ConfirmTransferAsync()
    {
        if (_selected?.Id is null || !Guid.TryParse(_transferRoleId, out var roleId)) return;
        _transferring = true;
        _transferError = null;
        try
        {
            await Console.TransferAsync(_selected.Id.Value, roleId, null,
                string.IsNullOrWhiteSpace(_transferReason) ? null : _transferReason);
            _showTransfer = false;
            // El ticket original se cierra y se crea uno nuevo en el rol destino; limpiar selección.
            _selected = null;
            _conversation = null;
            _lines.Clear();
            await RefreshAsync();
        }
        catch (Exception ex) { _transferError = Describe(ex); }
        finally { _transferring = false; }
    }

    public void Dispose()
    {
        Hub.MessageReceived -= OnHubMessage;
        Hub.QueueChanged -= OnQueueChanged;
    }

    private static string Fmt(DateTimeOffset? dt) => (dt ?? DateTimeOffset.UtcNow).ToLocalTime().ToString("dd/MM HH:mm");
    private static string Fmt(DateTime dt) => dt.ToLocalTime().ToString("dd/MM HH:mm");

    private sealed record ChatLine(int Role, string Content, string Time);

    // ── Mapeos de presentación (enums como int) ────────────────────────────────

    private static bool CanResolve(int? status)  => status is 2 or 3 or 8;
    private static bool CanClose(int? status)    => status is 2 or 3 or 5 or 8;
    private static bool CanTransfer(int? status) => status is 1 or 2 or 3 or 8;

    private static MimoChatBubbleVariant BubbleVariant(int? role) => role switch
    {
        1 => MimoChatBubbleVariant.Bot,
        2 => MimoChatBubbleVariant.System,
        3 => MimoChatBubbleVariant.Agent,
        _ => MimoChatBubbleVariant.Customer
    };

    private static string AuthorLabel(int? role) => role switch
    {
        1 => "Bot", 2 => "Sistema", 3 => "Agente", _ => "Cliente"
    };

    private static string ChannelLabel(int? channel) => channel switch
    {
        1 => "Facebook", 2 => "Instagram", 3 => "WhatsApp", 4 => "Telegram", _ => "WebChat"
    };

    private static string PriorityLabel(int? p) => p switch
    {
        0 => "Baja", 2 => "Alta", 3 => "Urgente", _ => "Normal"
    };

    private static string StatusLabel(int? s) => s switch
    {
        0 => "Bot", 1 => "En cola", 2 => "Asignado", 3 => "En progreso", 4 => "Sin atender",
        5 => "Resuelto", 6 => "Encuesta", 7 => "Cerrado", 8 => "Reabierto", _ => "—"
    };

    private static MimoBadgeVariant StatusVariant(int? s) => s switch
    {
        1 => MimoBadgeVariant.Warning,
        2 or 3 => MimoBadgeVariant.Info,
        5 => MimoBadgeVariant.Success,
        4 => MimoBadgeVariant.Danger,
        _ => MimoBadgeVariant.Neutral
    };

    private static string Describe(Exception ex) => ex switch
    {
        ApiException { ResponseStatusCode: 409 } => "El ticket ya no está en cola.",
        ApiException { ResponseStatusCode: 401 } => "Tu sesión expiró. Inicia sesión de nuevo.",
        ApiException { ResponseStatusCode: 403 } => "No tienes permisos para esta acción.",
        ApiException { ResponseStatusCode: 404 } => "Recurso no encontrado.",
        ApiException api => $"Error del servidor ({api.ResponseStatusCode}).",
        _ => $"No se pudo completar la operación: {ex.Message}"
    };
}
