    "/internal-chat/history": {
      "get": {
        "tags": [
          "InternalChat"
        ],
        "summary": "Historial paginado de mensajes con otro funcionario (query: agentId, page, pageSize).",
        "operationId": "GetInternalChatHistory",
        "parameters": [
          {
            "name": "agentId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "format": "int32",
              "default": 50
            }
